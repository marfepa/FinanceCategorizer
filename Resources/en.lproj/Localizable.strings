"appleAI.deterministic.optimizeSpending.title" = "Immediate optimization";
"appleAI.deterministic.optimizeSpending.summary" = "To optimize spending, it is best to start with concentration, recurrences and merchants that accumulate several charges. The local base already allows pointing where to start without touching aggressive rules yet.";
"appleAI.deterministic.optimizeSpending.bullet1" = "Start by reviewing the dominant category: %@.";
