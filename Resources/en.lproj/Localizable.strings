"appleAI.deterministic.optimizeSpending.bullet4" = "Convert repeated corrections into rules only when the pattern is stable.";

"appleAI.deterministic.importHealth.title" = "Import status";
"appleAI.deterministic.importHealth.summary" = "The last %lld imports total %lld imported rows and %lld items sent to review. That already gives a useful signal about input quality and subsequent manual load.";
"appleAI.deterministic.importHealth.noHistory" = "There are no recent imports registered yet, so the app does not have a stable import flow to evaluate yet.";
"appleAI.deterministic.importHealth.bullet1" = "Last import: %@.";
"appleAI.deterministic.importHealth.bullet1.empty" = "Make a first import to activate the full circuit.";
"appleAI.deterministic.importHealth.bullet2" = "It is advisable to quickly review the pending items left by recent imports.";
