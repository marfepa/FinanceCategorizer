"appleAI.deterministic.importHealth.bullet4" = "If the preview comes out clean, subsequent learning also improves.";

"appleAI.deterministic.importTips.title" = "Improve the next import";
"appleAI.deterministic.importTips.summary" = "The best import is the one that enters with clear dates, amount and concept, and leaves a small review queue. The app already has tools to detect problems before confirming the batch.";
"appleAI.deterministic.importTips.bullet1" = "Check the preview before importing, especially concept, date and amount.";
"appleAI.deterministic.importTips.bullet2" = "If the bank headers change, adjust the manual mapping in the preview.";
"appleAI.deterministic.importTips.bullet3" = "After the import, correct repeated merchants to reinforce local learning.";
"appleAI.deterministic.importTips.bullet4" = "Avoid mixing exports of different formats in the same monthly routine.";

"appleAI.deterministic.uncategorizedScan.title" = "Current ambiguity";
"appleAI.deterministic.uncategorizedScan.summary" = "Right now there are %lld movements pending or without category. That group is the main brake to automate better and read the financial status with clarity.";
"appleAI.deterministic.uncategorizedScan.bullet1" = "Representative examples: %@.";
"appleAI.deterministic.uncategorizedScan.bullet1.empty" = "No pending examples visible right now.";
"appleAI.deterministic.uncategorizedScan.bullet2" = "There is a clear repeated pattern: %@.";
"appleAI.deterministic.uncategorizedScan.bullet2.empty" = "A repeated merchant does not appear clear enough yet.";
"appleAI.deterministic.uncategorizedScan.bullet3" = "Correct common groups first and leave unique cases for the end.";
"appleAI.deterministic.uncategorizedScan.bullet4" = "Each good correction improves future suggestions and possible rules.";

"appleAI.deterministic.recurringMerchants.title" = "Repeated merchants";
"appleAI.deterministic.recurringMerchants.summary" = "Repeated patterns are the most profitable way to reduce manual work and detect stable spending. When the merchant is consistent, it is usually a good candidate for memory or rule.";
"appleAI.deterministic.recurringMerchants.bullet1" = "Candidates detected: %@.";
"appleAI.deterministic.recurringMerchants.bullet1.empty" = "Clear recurrences are not detected yet with current data.";
"appleAI.deterministic.recurringMerchants.bullet2" = "Review if any deserve a persistent rule.";
"appleAI.deterministic.recurringMerchants.bullet2.empty" = "Keep importing and correcting to consolidate patterns.";
"appleAI.deterministic.recurringMerchants.bullet3" = "They can also point to subscriptions or fixed expenses that should be monitored.";
"appleAI.deterministic.recurringMerchants.bullet3.empty" = "Consistent merchants improve both analysis and automation.";
"appleAI.deterministic.recurringMerchants.bullet4" = "If a merchant always ends up in the same category, it already has a good signal to automate.";

"appleAI.deterministic.analysisPatterns.title" = "Spending patterns";
"appleAI.deterministic.analysisPatterns.summary" = "In the range of %@, the net is %@ and the monthly average forecast points to %@. The reading improves a lot when the pending queue goes down and the categorized coverage goes up.";
"appleAI.deterministic.analysisPatterns.noHistory" = "There is not enough history yet to build a reliable analytical reading.";
