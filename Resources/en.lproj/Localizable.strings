"appleAI.deterministic.analysisPatterns.bullet3.empty" = "Not enough forecast for 6 months yet.";
"appleAI.deterministic.analysisPatterns.bullet4" = "Reducing pending improvements the reading of real trends.";

"appleAI.deterministic.savingsIdeas.title" = "Savings ideas";
"appleAI.deterministic.savingsIdeas.summary" = "To save usefully, it is best to attack first dominant spending, recurrences and tight budgets. The priority is not to touch everything, but to find 1 or 2 focuses with real volume.";
"appleAI.deterministic.savingsIdeas.bullet1" = "Start by reviewing %@.";
"appleAI.deterministic.savingsIdeas.bullet1.empty" = "First stabilize categories to be able to detect real savings.";
"appleAI.deterministic.savingsIdeas.bullet2" = "Audit this recurrence: %@.";
"appleAI.deterministic.savingsIdeas.bullet2.empty" = "Look for subscriptions or monthly charges that are not yet clear.";
"appleAI.deterministic.savingsIdeas.bullet3" = "There is direct pressure on budget: %@.";
"appleAI.deterministic.savingsIdeas.bullet3.empty" = "There is no category clearly over budget yet.";
"appleAI.deterministic.savingsIdeas.bullet4" = "Avoid creating rules too broad when the merchant is still ambiguous.";

"appleAI.deterministic.reviewPriorities.title" = "Review priority";
"appleAI.deterministic.reviewPriorities.summary" = "The queue should not be reviewed at random. It is advisable to order by repetition, impact and ability to generate reusable learning.";
"appleAI.deterministic.reviewPriorities.bullet1" = "Start with %@.";
"appleAI.deterministic.reviewPriorities.bullet1.empty" = "Start with the most repeated and similar movements.";
"appleAI.deterministic.reviewPriorities.bullet2" = "Priority examples: %@.";
"appleAI.deterministic.reviewPriorities.bullet2.empty" = "No pending examples visible.";
"appleAI.deterministic.reviewPriorities.bullet3" = "Then correct merchants of medium or high amount.";
"appleAI.deterministic.reviewPriorities.bullet4" = "Leave unique and little informative movements for the end.";

"appleAI.deterministic.batchResolution.title" = "Batch resolution";
"appleAI.deterministic.batchResolution.summary" = "The fastest way to empty the queue is to group merchants or descriptions that are repeated with the same pattern. That's where each correction returns more time.";
"appleAI.deterministic.batchResolution.bullet1" = "Clear batches: %@.";
"appleAI.deterministic.batchResolution.bullet1.empty" = "Not yet clear batches to resolve in block.";
"appleAI.deterministic.batchResolution.bullet2" = "Apply category to repeated groups before individual cases.";
"appleAI.deterministic.batchResolution.bullet3" = "If the pattern is stable, consider creating a rule after confirming the batch.";
"appleAI.deterministic.batchResolution.bullet4" = "That reduces the manual load of the next import.";

"appleAI.deterministic.categoryCleanup.title" = "Category cleanup";
"appleAI.deterministic.categoryCleanup.summary" = "A small, clear and no-duplicates catalog improves both analysis and learning. Empty categories or almost without use usually add noise before value.";
"appleAI.deterministic.categoryCleanup.bullet1" = "Unused categories: %@.";
"appleAI.deterministic.categoryCleanup.bullet1.empty" = "No obvious empty categories.";
"appleAI.deterministic.categoryCleanup.bullet2" = "Possible duplicates: %@.";
"appleAI.deterministic.categoryCleanup.bullet2.empty" = "No clearly duplicated names are detected.";
"appleAI.deterministic.categoryCleanup.bullet3" = "Avoid too fine categories if they barely receive movements.";
"appleAI.deterministic.categoryCleanup.bullet4" = "Unify overlaps before creating new rules.";

"appleAI.deterministic.ruleCandidates.title" = "Candidates for rules";
"appleAI.deterministic.ruleCandidates.summary" = "The best rules are born from repeated merchants with low ambiguity. The most valuable signal appears when several corrections always end in the same category.";
